{
  "expo": {
    "name": "DexBinder PoC Scanner",
    "slug": "dexbinder-poc-scanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.dexbinder.pocscanner",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": ["latin"],
          "ocrUseBundled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f2fb55c6-3a28-40dd-ba97-e5f749bc5e0c"
      }
    }
  }
}
